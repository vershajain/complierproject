# Copy this file to ".env" (same folder) and fill it in. Only needed for the AI Fix feature.
# Add ONE key. If you add more than one, set AI_PROVIDER to anthropic, openai or gemini.
PORT=5000
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# AI_PROVIDER=anthropic
# Optional: override the default model (anthropic: claude-sonnet-5-5, openai: gpt-4o-mini, gemini: gemini-2.0-flash)
# AI_MODEL=
